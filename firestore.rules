rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Website global content (hero images, text, contact info) synced across all devices
    match /website_content/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Uploaded images & media gallery synced across all devices
    match /uploaded_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Products catalog synced across all devices
    match /products_data/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Individual products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Health check & connection test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
